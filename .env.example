# ---------------------------------------------------------------- processador

# Pasta MODELO que sera duplicada a cada envio (nao e modificada).
# E a sua ACServerFiles.
TEMPLATE_DIR=/opt/serverac/ACServerFiles

# Onde cada copia (um servidor) e criada. Vira /opt/serverac/servidores/<nome>
RUNS_DIR=/opt/serverac/servidores

# Executavel iniciado dentro da copia depois de extrair o zip.
# No Ubuntu use o build Linux (arquivo 'AssettoServer', SEM extensao).
ENTRY_FILE=AssettoServer

# Se o ENTRY_FILE nao existir, tenta estes (separados por virgula).
ENTRY_ALTERNATIVOS=AssettoServer.exe

# background = sobe o servidor e ele fica no ar (correto para AssettoServer)
# aguardar   = espera o processo terminar (so para script que termina sozinho)
MODO=background

# Segundos esperando para confirmar que o servidor realmente subiu
STARTUP_WAIT_S=3

# So no MODO=aguardar: tempo maximo do processo
RUN_TIMEOUT_S=120

# Para rodar um .exe do Windows no Linux. Deixe VAZIO se usa o build Linux.
# Exemplo: EXE_RUNNER=wine
EXE_RUNNER=

# Quantas pastas antigas manter (0 = nunca apagar).
# Cada servidor e uma copia de ~120 MB, entao vale limitar.
# Se ativar, pasta com servidor rodando nunca e apagada.
KEEP_RUNS=3

# ---------------------------------------------------------------- site

# Senha de acesso da pagina. TROQUE por algo longo e aleatorio:
#   openssl rand -hex 32
UPLOAD_TOKEN=troque-isto-por-um-token-aleatorio-longo

# Limite de tamanho do zip
MAX_UPLOAD_MB=200
